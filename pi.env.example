# Your Pi and panel. Copy to pi.env (git ignores it) and edit:
# Ваш Pi и экран. Скопируйте в pi.env (git его игнорирует) и поправьте:
#   cp pi.env.example pi.env

# --- Raspberry Pi 5 ---------------------------------------------------------
# ssh login with sudo / вход по ssh, пользователь с sudo
PI_HOST=pi@raspberrypi.local
# optional private key (else ssh uses its config and agent) / ssh-ключ, необязательно
PI_KEY=

# --- Display / Экран ----------------------------------------------------------
# HDMI port of the panel: HDMI-A-1 (next to USB-C power) or HDMI-A-2.
# Разъём панели: HDMI-A-1 (рядом с USB-C питания) или HDMI-A-2.
# Find it / узнать: for s in /sys/class/drm/card*-HDMI-A-*/status; do echo $s; cat $s; done
PANEL_CONNECTOR=HDMI-A-1
# rbp draws 1280x800; other panels get scaled / rbp рисует 1280x800, другое — масштаб
PANEL_MODE=1280x800@60
# 0 = normal. 180 = ONLY for a panel mounted upside down (optional, see README).
# 0 — обычно. 180 — ТОЛЬКО если панель стоит вверх ногами (необязательно, см. README).
PANEL_ROTATE=0

# --- Controller / Контроллер --------------------------------------------------
# auto = the map of the controller plugged in (DDJ-FLX4 or DDJ-GRV6); or flx4 / grv6
# auto — карта подключённого пульта (DDJ-FLX4 или DDJ-GRV6); или flx4 / grv6
MIDI_MAP=auto
# 1 = power-cycle USB once at boot if no controller enumerated (a bus-powered
# FLX4 needs it on the Pi 5). 0 = off.
# 1 — передёрнуть питание USB при загрузке, если пульт не определился (нужно
# FLX4 с питанием от USB на Pi 5). 0 — выкл.
USB_POWERCYCLE=1

# --- Build / Сборка -------------------------------------------------------------
# where make assets puts the prepared assets / куда make assets кладёт ассеты
ASSETS=extracted
