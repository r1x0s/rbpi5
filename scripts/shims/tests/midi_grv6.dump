0.087000 NOTEOFF ch=6 note=71 vel=0
# SHIFT + LOAD 1 / 2
0.088000 NOTEON ch=6 note=88 vel=127
0.089000 NOTEOFF ch=6 note=88 vel=0
0.090000 NOTEON ch=6 note=89 vel=127
0.091000 NOTEOFF ch=6 note=89 vel=0
# BACK, then VIEW (-> BROWSE), PREVIEW (nothing), DISCOVER (-> SOURCE)
0.092000 NOTEON ch=6 note=101 vel=127
0.093000 NOTEOFF ch=6 note=101 vel=0
0.094000 NOTEON ch=6 note=122 vel=127
0.095000 NOTEOFF ch=6 note=122 vel=0
0.096000 NOTEON ch=6 note=54 vel=127
0.097000 NOTEOFF ch=6 note=54 vel=0
0.098000 NOTEON ch=6 note=53 vel=127
0.099000 NOTEOFF ch=6 note=53 vel=0

