# rbpi4b midi dump v1 -- t is seconds since the first event
#
# A HAND-ASSEMBLED fixture for map_grv6.c. Unlike midi_flx4.dump, every channel,
# note, CC and value shape below was MEASURED on the unit -- the 2026-10-13
# capture written up in docs/port/grv6-midi.md -- except the lines marked
# "expected", which stand for controls the capture did not reach. The ORDER and
# the timestamps are not a recording: the lines are arranged so that each row of
# test_grv6.c's expectation table comes from exactly one line here, and a line
# expected to produce NOTHING sits between two that do, so a spurious keycode
# shifts the whole table.
#
# Not here: the jog (its speed is measured against real time, so test_grv6.c
# drives it directly with real sleeps), and grv6_startup() (it writes two
# absolute rbp addresses, which are a segfault off the device -- see
# midi_flx4.dump's header).
#
# The System Reset the unit sends when a side switches to deck 3/4 is recorded
# the way MIDI_DUMP records any type the format cannot replay: as a SKIP line.
0.000000 SKIP type=41

# ---- deck 1 (ch 0) ----
0.001000 NOTEON ch=0 note=11 vel=127
0.002000 NOTEOFF ch=0 note=11 vel=0
0.003000 NOTEON ch=0 note=12 vel=127
0.004000 NOTEOFF ch=0 note=12 vel=0
# BEAT SYNC: one gesture, sent on the first edge; the release is swallowed
0.005000 NOTEON ch=0 note=88 vel=127
0.006000 NOTEOFF ch=0 note=88 vel=0
# SHIFT, then SHIFT + PLAY (71): both produce nothing
0.007000 NOTEON ch=0 note=63 vel=127
0.008000 NOTEON ch=0 note=71 vel=127
0.009000 NOTEOFF ch=0 note=71 vel=0
0.010000 NOTEOFF ch=0 note=63 vel=0
# MASTER TEMPO -> key lock
0.011000 NOTEON ch=0 note=26 vel=127
0.012000 NOTEOFF ch=0 note=26 vel=0
# KEY SYNC, MEMORY, CUE/LOOP CALL < and >: log-only
0.013000 NOTEON ch=0 note=101 vel=127
0.014000 NOTEOFF ch=0 note=101 vel=0
0.015000 NOTEON ch=0 note=61 vel=127
0.016000 NOTEOFF ch=0 note=61 vel=0
0.017000 NOTEON ch=0 note=81 vel=127
0.018000 NOTEOFF ch=0 note=81 vel=0
0.019000 NOTEON ch=0 note=83 vel=127
0.020000 NOTEOFF ch=0 note=83 vel=0
# loop IN, OUT, 4 BEAT / EXIT
0.021000 NOTEON ch=0 note=16 vel=127
0.022000 NOTEOFF ch=0 note=16 vel=0
0.023000 NOTEON ch=0 note=17 vel=127
0.024000 NOTEOFF ch=0 note=17 vel=0
0.025000 NOTEON ch=0 note=77 vel=127
0.026000 NOTEOFF ch=0 note=77 vel=0
# jog touch
0.027000 NOTEON ch=0 note=54 vel=127
0.028000 NOTEOFF ch=0 note=54 vel=0
# channel CUE twice: the latch goes on, then off (no keycode either time)
0.029000 NOTEON ch=0 note=84 vel=127
0.030000 NOTEOFF ch=0 note=84 vel=0
0.031000 NOTEON ch=0 note=84 vel=127
0.032000 NOTEOFF ch=0 note=84 vel=0

# ---- deck 2 (ch 1): PLAY measured, channel CUE expected ----
0.033000 NOTEON ch=1 note=11 vel=127
0.034000 NOTEOFF ch=1 note=11 vel=0
0.035000 NOTEON ch=1 note=84 vel=127
0.036000 NOTEOFF ch=1 note=84 vel=0

# ---- the left side switches to deck 3 and back: nothing reaches rbp ----
# (block [23] of the capture, in its order)
0.037000 NOTEON ch=2 note=114 vel=127
0.038000 NOTEOFF ch=2 note=114 vel=0
0.039000 NOTEON ch=2 note=60 vel=127
0.040000 NOTEOFF ch=0 note=60 vel=0
0.041000 CONTROLLER ch=2 cc=0 val=64
0.042000 CONTROLLER ch=2 cc=32 val=0
0.043000 SKIP type=41
0.044000 NOTEON ch=2 note=11 vel=127
0.045000 NOTEOFF ch=2 note=11 vel=0
0.046000 CONTROLLER ch=2 cc=19 val=100
0.047000 CONTROLLER ch=2 cc=34 val=66
0.048000 NOTEON ch=0 note=114 vel=127
0.049000 NOTEOFF ch=0 note=114 vel=0
0.050000 NOTEON ch=0 note=60 vel=127
0.051000 NOTEOFF ch=2 note=60 vel=0

# ---- the mixer ----
0.052000 CONTROLLER ch=0 cc=19 val=0
0.053000 CONTROLLER ch=1 cc=19 val=127
0.054000 CONTROLLER ch=0 cc=4 val=64
# the LSB of the same knob: unbound, so nothing
0.055000 CONTROLLER ch=0 cc=36 val=17
0.056000 CONTROLLER ch=0 cc=7 val=64
0.057000 CONTROLLER ch=0 cc=11 val=64
0.058000 CONTROLLER ch=0 cc=15 val=64
0.059000 CONTROLLER ch=6 cc=23 val=64
# CH2's Sound Color FX knob: expected on CC 24
0.060000 CONTROLLER ch=6 cc=24 val=127
0.061000 CONTROLLER ch=6 cc=31 val=127
0.062000 CONTROLLER ch=6 cc=12 val=64
0.063000 CONTROLLER ch=6 cc=13 val=0
# BOOTH LEVEL: hardware-only (D20), nothing
0.064000 CONTROLLER ch=6 cc=9 val=100
0.065000 CONTROLLER ch=6 cc=41 val=5
# MASTER LEVEL: the HDMI mirror's gain and nothing else (raw 8192 = 0.5)
0.066000 CONTROLLER ch=6 cc=8 val=64
0.067000 CONTROLLER ch=6 cc=40 val=0
# MASTER CUE: the controller's own (MASTER_CUE_HW=1), nothing
0.068000 NOTEON ch=6 note=99 vel=127
0.069000 NOTEOFF ch=6 note=99 vel=0

